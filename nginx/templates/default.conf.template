# La imagen oficial de nginx renderiza este template con envsubst al arrancar
# y lo deja en /etc/nginx/conf.d/, dentro del bloque `http`. Solo se sustituyen
# BACKEND_UPSTREAM, PORT y NGINX_LOCAL_RESOLVERS (NGINX_ENVSUBST_FILTER en el
# Dockerfile); las variables propias de nginx ($host, $remote_addr...) llegan
# intactas.

server_tokens off;

# El proxy que termina TLS (Caddy en el Droplet) manda la IP del cliente en
# X-Forwarded-For. realip hace que $remote_addr sea esa IP, así los topes de
# abajo cuentan por cliente y no por proxy. Solo se le cree a la red privada
# de Docker (172.16.0.0/12), donde vive Caddy: el firewall deja abiertos solo
# los puertos de Caddy, y Caddy reemplaza el X-Forwarded-For que mande el
# cliente. Django sigue resolviendo la IP por su cuenta con NUM_PROXIES.
set_real_ip_from 172.16.0.0/12;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# El proxy que termina TLS manda el esquema original; sin el header (pruebas
# en local) se usa el de la conexión.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

# Primera capa de tope por IP de la conexión; los throttles de DRF siguen
# siendo la segunda capa, por ruta y por IP del cliente. Con realip, la IP es
# la del cliente y no la del proxy que termina TLS.
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

# Login del admin de Django: Django no limita sus intentos, así que sin esto
# se pueden probar contraseñas sin tope. Solo cuentan los POST (una key vacía
# no se contabiliza); abrir el formulario o navegar el admin no suma.
map $request_method $admin_login_key {
    POST $binary_remote_addr;
    default "";
}
limit_req_zone $admin_login_key zone=admin_login:10m rate=5r/m;
limit_req_status 429;

# DNS del contenedor, leído de /etc/resolv.conf al arrancar por
# 15-local-resolvers.envsh de la imagen (NGINX_ENTRYPOINT_LOCAL_RESOLVERS en el
# Dockerfile). `valid` acota cuánto vive una IP en caché: tras un deploy o un
# reinicio del backend, el proxy toma la nueva en segundos. Sin IPv6 porque la
# red de Docker entre los contenedores es IPv4 (el default de Docker).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
resolver_timeout 5s;

server {
    # El puerto sale de PORT para que el hosting pueda elegirlo; el Dockerfile
    # deja 80 por defecto.
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    # host:puerto de gunicorn; proxy-backend.conf lo usa en `proxy_pass`.
    set $django_upstream ${BACKEND_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # Los certificados de exención de impuestos (hasta 1.5 MB) viajan en base64
    # dentro de un JSON.
    client_max_body_size 5m;

    gzip on;
    gzip_vary on;
    # Sin `any`, nginx no comprime cuando el request trae `Via` (proxies).
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Stripe reintenta los webhooks y la firma ya los protege: un 429 solo
    # demoraría la confirmación de pagos.
    location /api/webhooks/stripe/ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location = /api/health/ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # El sitemap lo genera Django en /api/sitemap.xml; los buscadores lo piden
    # en la raíz del dominio.
    location = /sitemap.xml {
        rewrite ^ /api/sitemap.xml break;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location /django-admin/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location = /django-admin/login/ {
        limit_req zone=admin_login burst=5 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Estáticos de Django (admin), servidos por WhiteNoise. Vite emite en
    # /assets/, así que no hay choque con el build del SPA.
    location /static/ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Archivos con hash en el nombre: nunca cambian de contenido, se cachean
    # 15 días. Un asset que falta devuelve 404 y no index.html, para no
    # cachear HTML como JS.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=1296000, immutable" always;
        try_files $uri =404;
    }

    # index.html apunta a los assets del deploy vigente: se revalida siempre.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Rutas del SPA (React Router): lo que no es un archivo cae en index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
